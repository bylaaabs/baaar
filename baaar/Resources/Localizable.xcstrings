    "macos does not say when access changes, so this page checks every second while it is open." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macos no avisa cuando cambia un acceso, así que esta página lo comprueba cada segundo mientras está abierta."
