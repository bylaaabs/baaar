      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reordenar necesita acceso al archivo de disposición de la barra de menús. selecciona com.apple.MenuBar.plist una vez y baaar podrá mover ítems sin tocar el cursor."
          }
        }
      }
    },
