    "apple items other than wi-fi, bluetooth, battery, sound, displays, keyboard, screen mirroring, clock and control center can't be hidden: macos hides them itself while anything is hidden." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "los ítems de apple que no son wi-fi, bluetooth, batería, sonido, pantallas, teclado, duplicación de pantalla, reloj y centro de control no se pueden ocultar: macos los oculta por su cuenta mientras haya algo oculto."
          }
        }
      }
    },
